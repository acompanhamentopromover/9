<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<title>Fórmulas de Geometria 9º Ano - Promover</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<script defer src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<style id="css-motor">
:root {
    --border-color: #000000;
    --white: #FFFFFF;
    --theme-text-active: #FFFFFF;
    --correct-bg: #D1FAE5;
    --correct-border: #059669;
    --wrong-bg: #FFE4E6;
    --wrong-border: #BE123C;
    --bg-color: #ECFEFF;
    --text-color: #0F172A;
    --theme-light: #CFFAFE;
    --theme-medium: #22D3EE;
    --theme-dark: #155E75;
    --theme-contrast: #C2410C;
    --theme-accent: #0891B2;
}

* { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
    -webkit-tap-highlight-color: transparent;
}

html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

body {
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    padding: 12px 10px 30px 10px;
    background-image: linear-gradient(var(--theme-light) 1px, transparent 1px), linear-gradient(90deg, var(--theme-light) 1px, transparent 1px);
    background-size: 20px 20px;
    transition: padding-bottom 0.2s ease;
}

body.quiz-active {
    padding-bottom: 95px; /* Espaço para o rodapé fixo exclusivo do Quiz */
}

@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideUp { from { transform: translateY(8px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.pulse-effect { animation: pulse 1.2s infinite; display: inline-block; }
@keyframes pulse {
    0% { transform: scale(1); }
    20% { transform: scale(1.15); color: var(--theme-contrast); }
    40% { transform: scale(1); }
    100% { transform: scale(1); }
}

/* ========================================================
   CONTAINER & CABEÇALHO RESPONSIVO
   ======================================================== */
.container {
    width: 100%;
    max-width: 660px;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.logo-header {
    width: 100%;
    display: flex;
    justify-content: center;
    flex-direction: column;
    align-items: center;
    padding: 4px 0 8px 0;
}
.css-logo {
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    font-weight: 900;
    color: var(--white);
    text-transform: uppercase;
    letter-spacing: -0.5px;
    border: 2.5px solid var(--border-color);
    padding: 6px 18px;
    border-radius: 12px;
    background: var(--theme-dark);
    box-shadow: 3.5px 3.5px 0px var(--theme-contrast);
    text-align: center;
    margin-bottom: 8px;
}
h1 {
    font-size: clamp(1.35rem, 4.5vw, 1.7rem);
    font-weight: 900;
    color: var(--text-color);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    line-height: 1.25;
}
.subtitle {
    font-size: clamp(0.82rem, 2.5vw, 0.92rem);
    color: var(--theme-dark);
    font-weight: 600;
    text-align: center;
    margin-top: 3px;
    line-height: 1.35;
}

/* ========================================================
   TABS DE NAVEGAÇÃO RESPONSIVAS
   ======================================================== */
.toggle-container {
    background-color: var(--white);
    border: 2.5px solid var(--border-color);
    border-radius: 50px;
    padding: 3px;
    display: flex;
    box-shadow: 3.5px 3.5px 0px var(--border-color);
    gap: 3px;
    width: 100%;
}
.toggle-btn {
    flex: 1;
    border: none;
    background: none;
    padding: 9px 4px;
    border-radius: 40px;
    font-family: inherit;
    font-weight: 700;
    font-size: clamp(0.78rem, 2.8vw, 0.9rem);
    color: var(--theme-dark);
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    white-space: nowrap;
}
.toggle-btn.active {
    background-color: var(--theme-dark);
    color: var(--theme-text-active);
    box-shadow: 0px 2px 4px rgba(0,0,0,0.2);
}

.view-section {
    display: none;
    animation: fadeIn 0.25s ease;
    flex-direction: column;
    gap: 14px;
    width: 100%;
}

/* ========================================================
   FÓRMULAS VERTICAIS & FRAÇÕES REAIS (SEM CÓDIGO CRU)
   ======================================================== */
.vfrac {
    display: inline-flex;
    flex-direction: column;
    vertical-align: middle;
    text-align: center;
    font-size: 0.92em;
    line-height: 1.15;
    margin: 0 4px;
}
.vnum {
    border-bottom: 2.2px solid currentColor;
    padding: 0 4px 2px 4px;
    font-weight: 800;
}
.vden {
    padding: 2px 4px 0 4px;
    font-weight: 800;
}

.vmath-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    margin: 6px 0;
}
.vmath-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: #FFFFFF;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow: 2.5px 2.5px 0px rgba(0,0,0,0.1);
}
.vmath-label {
    font-size: 0.74rem;
    font-weight: 900;
    color: var(--theme-dark);
    text-transform: uppercase;
    background: var(--theme-light);
    padding: 4px 8px;
    border-radius: 6px;
    border: 1.5px solid var(--border-color);
    white-space: nowrap;
}
.vmath-expr {
    font-size: clamp(1.05rem, 3.8vw, 1.22rem);
    font-weight: 900;
    color: var(--theme-contrast);
    letter-spacing: 0.3px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 1;
    word-break: break-word;
}

/* ========================================================
   SEÇÃO TEORIA
   ======================================================== */
.search-container { position: relative; width: 100%; }
.search-input {
    width: 100%;
    padding: 12px 18px 12px 44px;
    border: 2px solid var(--border-color);
    border-radius: 50px;
    background-color: var(--white);
    font-family: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-color);
    box-shadow: 3px 3px 0px var(--border-color);
    outline: none;
    transition: all 0.2s ease;
}
.search-input:focus {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px var(--theme-contrast);
    border-color: var(--theme-dark);
}
.search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1rem;
    opacity: 0.7;
}
#no-results {
    text-align: center;
    color: var(--theme-dark);
    font-weight: 700;
    display: none;
    padding: 16px;
}

.content-group { display: flex; flex-direction: column; gap: 8px; width: 100%; }
.section-badge {
    display: inline-block;
    padding: 5px 12px;
    background-color: var(--theme-dark);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 800;
    border-radius: 8px;
    border: 2px solid var(--border-color);
    box-shadow: 2.5px 2.5px 0px rgba(0,0,0,0.2);
    text-transform: uppercase;
    align-self: flex-start;
}
.theory-box {
    display: flex;
    flex-direction: column;
    padding: 16px 14px;
    border-radius: 16px;
    background-color: var(--white);
    border: 2px solid var(--border-color);
    box-shadow: 3.5px 3.5px 0px var(--border-color);
    font-weight: 500;
    font-size: 0.9rem;
    line-height: 1.55;
    position: relative;
    overflow: hidden;
    gap: 12px;
}
.theory-box::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background-color: var(--theme-contrast);
    border-right: 1.5px solid var(--border-color);
}
.theory-box h3 {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--theme-dark);
    border-bottom: 2px solid var(--theme-light);
    padding-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 6px;
}

/* TABELAS RESPONSIVAS */
.table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 8px;
    margin: 4px 0;
}
.tabela {
    width: 100%;
    min-width: 280px;
    border-collapse: collapse;
    text-align: center;
    font-size: clamp(0.78rem, 2.6vw, 0.86rem);
    font-weight: 600;
    background: #fff;
}
.tabela th { background: var(--theme-light); color: var(--theme-dark); padding: 8px 6px; font-weight: 800; }
.tabela th, .tabela td { border: 1.5px solid var(--border-color); padding: 8px 6px; }

/* DESENHOS SVG GERAIS */
.desenho { width: 100%; max-width: 440px; height: auto; display: block; margin: 6px auto; }
.d-fundo { fill: var(--theme-light); stroke: var(--border-color); stroke-width: 2; }
.d-linha { fill: none; stroke: var(--border-color); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
.d-tracejado { fill: none; stroke: var(--theme-contrast); stroke-width: 2; stroke-dasharray: 4,4; }
.d-texto { fill: var(--text-color); font-family: inherit; font-size: 13px; font-weight: 700; }

/* ========================================================
   SEÇÃO FLASHCARDS INTERATIVOS (AUTOFIT PARA QUALQUER TELA)
   ======================================================== */
.flashcards-header {
    background: var(--white);
    border: 2px solid var(--border-color);
    border-radius: 14px;
    padding: 12px;
    box-shadow: 3.5px 3.5px 0px var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.flashcard-stats {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 800;
    font-size: 0.82rem;
}
.fc-filter-bar {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-bottom: 3px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
}
.fc-filter-bar::-webkit-scrollbar { display: none; }
.filter-chip {
    white-space: nowrap;
    padding: 5px 11px;
    border-radius: 20px;
    border: 2px solid var(--border-color);
    background: var(--white);
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
}
.filter-chip.active {
    background: var(--theme-dark);
    color: var(--white);
    box-shadow: 2px 2px 0px var(--theme-contrast);
}

/* O CARD PRINCIPAL COM FLIP 3D E ALTURA DINÂMICA */
.flashcard-viewport {
    perspective: 1200px;
    width: 100%;
    margin: 2px 0;
    transition: height 0.25s ease;
}
.fc-card {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.4, 0.2, 0.2, 1), height 0.25s ease;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
}
.fc-card.is-flipped {
    transform: rotateY(180deg);
}
.fc-face {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border: 2.5px solid var(--border-color);
    border-radius: 18px;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 5px 5px 0px var(--border-color);
    background: #FFFFFF;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
}
.fc-back {
    background: #F8FAFC;
    transform: rotateY(180deg);
    border-color: var(--theme-dark);
    box-shadow: 5px 5px 0px var(--theme-contrast);
}

.fc-card-tag {
    align-self: flex-start;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1.5px solid var(--border-color);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    background: var(--theme-light);
    color: var(--theme-dark);
}
.fc-prompt {
    font-size: clamp(1rem, 3.4vw, 1.15rem);
    font-weight: 800;
    text-align: center;
    color: var(--text-color);
    margin: 8px 0;
    line-height: 1.4;
}
.fc-illustration {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 0;
    min-height: 100px;
}
.fc-illustration svg {
    max-width: 100%;
    max-height: 125px;
    height: auto;
    display: block;
}
.fc-click-hint {
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--theme-dark);
    background: var(--theme-light);
    border: 1.5px dashed var(--theme-dark);
    border-radius: 8px;
    padding: 6px 10px;
    margin-top: 6px;
}

/* VERSO DO CARD */
.fc-formula-box {
    background: #FFFFFF;
    border: 2px solid var(--theme-contrast);
    border-radius: 12px;
    padding: 10px 8px;
    margin: 6px 0;
    box-shadow: 2.5px 2.5px 0px rgba(194, 65, 12, 0.15);
}
.fc-formula-title {
    font-size: 0.72rem;
    font-weight: 900;
    color: var(--theme-contrast);
    text-transform: uppercase;
    margin-bottom: 6px;
    text-align: center;
}

.fc-vars-list {
    background: #FFFFFF;
    border: 1.5px solid var(--border-color);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: clamp(0.76rem, 2.4vw, 0.82rem);
    color: var(--text-color);
    line-height: 1.45;
    margin-bottom: 6px;
}
.fc-macete {
    background: #FEF3C7;
    border-left: 3.5px solid #D97706;
    border-radius: 6px;
    padding: 8px 10px;
    font-size: clamp(0.76rem, 2.4vw, 0.82rem);
    font-weight: 600;
    color: #92400E;
    line-height: 1.4;
}

/* CONTROLES DO FLASHCARD */
.fc-controls {
    display: flex;
    gap: 6px;
    width: 100%;
}
.fc-nav-btn {
    flex: 1;
    min-height: 44px;
    padding: 8px 4px;
    border-radius: 10px;
    border: 2px solid var(--border-color);
    font-family: inherit;
    font-weight: 800;
    font-size: clamp(0.8rem, 2.7vw, 0.9rem);
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 2.5px 2.5px 0px var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}
.fc-btn-prev { background: #FFFFFF; color: var(--text-color); }
.fc-btn-next { background: var(--theme-dark); color: #FFFFFF; }
.fc-btn-flip { background: var(--theme-contrast); color: #FFFFFF; }
.fc-nav-btn:active { transform: translate(1.5px, 1.5px); box-shadow: 1px 1px 0px var(--border-color); }

/* BARRAS DE REVISÃO ANKI */
.fc-review-bar {
    display: flex;
    gap: 6px;
    margin-top: 6px;
}
.fc-review-btn {
    flex: 1;
    min-height: 38px;
    padding: 6px;
    border-radius: 8px;
    border: 1.5px solid var(--border-color);
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 2px 2px 0px var(--border-color);
}
.fc-btn-hard { background: #FEE2E2; color: #991B1B; }
.fc-btn-easy { background: #DCFCE7; color: #166534; }

/* MODO GRADE PARA FLASHCARDS */
.fc-grid-toggle {
    background: none;
    border: none;
    font-family: inherit;
    font-weight: 700;
    color: var(--theme-dark);
    text-decoration: underline;
    cursor: pointer;
    font-size: 0.8rem;
    text-align: center;
    margin-top: 2px;
    padding: 6px;
}
.fc-cards-grid {
    display: none;
    grid-template-columns: 1fr;
    gap: 12px;
}
.fc-grid-item {
    background: #FFFFFF;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    padding: 14px;
    box-shadow: 3px 3px 0px var(--border-color);
}

/* ========================================================
   SEÇÃO DE PRÁTICA (QUIZ ENGINE)
   ======================================================== */
.question-map {
    display: flex;
    gap: 5px;
    overflow-x: auto;
    padding: 4px 2px 6px 2px;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
}
.question-map::-webkit-scrollbar { display: none; }
.map-dot {
    min-width: 35px;
    height: 35px;
    border: 2px solid var(--border-color);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.82rem;
    color: var(--theme-dark);
    background: white;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 2px 2px 0px var(--border-color);
    flex-shrink: 0;
}
.map-dot.active {
    background-color: var(--theme-dark);
    color: white;
    box-shadow: 2px 2px 0px var(--theme-contrast);
    transform: scale(1.05);
}
.map-dot.answered-correct {
    background-color: var(--correct-bg);
    border-color: var(--correct-border);
    color: var(--correct-border);
}
.map-dot.answered-wrong {
    background-color: var(--wrong-bg);
    border-color: var(--wrong-border);
    color: var(--wrong-border);
}

.difficulty-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 6px;
    border: 1.5px solid var(--border-color);
    box-shadow: 1.5px 1.5px 0px rgba(0,0,0,1);
}
.dif-facil { background: #D1FAE5; color: #065F46; }
.dif-medio { background: #FEF08A; color: #713F12; }
.dif-dificil { background: #FECACA; color: #7F1D1D; }

.quiz-card {
    background: #FFFFFF;
    border: 2.5px solid var(--border-color);
    border-radius: 16px;
    padding: 16px 14px;
    box-shadow: 4px 4px 0px var(--border-color);
}
.quiz-q-title {
    font-size: clamp(0.95rem, 3.2vw, 1.05rem);
    font-weight: 800;
    color: var(--text-color);
    line-height: 1.45;
    margin-bottom: 14px;
}

.option-btn {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 11px 12px;
    background-color: var(--white);
    border: 2px solid var(--border-color);
    border-radius: 10px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: all 0.1s ease;
    box-shadow: 2.5px 2.5px 0px rgba(0,0,0,0.08);
    font-family: inherit;
    font-size: clamp(0.85rem, 2.7vw, 0.92rem);
    font-weight: 600;
    text-align: left;
    color: var(--text-color);
}
.option-btn:hover:not(:disabled) {
    transform: translate(-1.5px, -1.5px);
    box-shadow: 3.5px 3.5px 0px var(--theme-contrast);
    border-color: var(--theme-dark);
}
.opt-circle {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--border-color);
    margin-right: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 0.85rem;
    flex-shrink: 0;
    background: var(--theme-light);
    color: var(--theme-dark);
}
.option-btn.correct {
    background-color: var(--correct-bg);
    border-color: var(--correct-border);
    box-shadow: 2px 2px 0px var(--correct-border);
}
.option-btn.correct .opt-circle {
    background-color: var(--correct-border);
    color: white;
    border-color: var(--correct-border);
}
.option-btn.wrong {
    background-color: var(--wrong-bg);
    border-color: var(--wrong-border);
    opacity: 0.9;
    box-shadow: none;
}
.option-btn.wrong .opt-circle {
    background-color: var(--wrong-border);
    color: white;
    border-color: var(--wrong-border);
}
.option-btn.disabled { pointer-events: none; }

.feedback-box {
    display: none;
    margin-top: 14px;
    background-color: #FAFAFA;
    border: 2px dashed var(--theme-dark);
    border-radius: 10px;
    padding: 12px;
    animation: slideUp 0.25s ease-out;
}
.feedback-title {
    font-weight: 900;
    text-transform: uppercase;
    font-size: 0.86rem;
    margin-bottom: 5px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--theme-dark);
}
.feedback-desc {
    font-size: 0.85rem;
    line-height: 1.45;
    color: #1E293B;
}

/* TELA DE RESULTADOS */
.result-card {
    background: white;
    border: 2.5px solid var(--border-color);
    border-radius: 18px;
    padding: 24px 16px;
    box-shadow: 5px 5px 0px var(--border-color);
    margin-bottom: 16px;
    text-align: center;
    display: none;
}
.stars-container { font-size: 2.6rem; margin: 6px 0; letter-spacing: 3px; }
.percentage-big {
    font-size: clamp(3rem, 10vw, 3.8rem);
    font-weight: 900;
    color: var(--theme-dark);
    line-height: 1;
