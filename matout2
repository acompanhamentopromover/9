                    </div>
                    <div class="vmath-row">
                        <span class="vmath-label">Área Interna</span>
                        <span class="vmath-expr">A = π · R²</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
