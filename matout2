function setMode(mode) {
    activeMode = mode;
    
    document.getElementById('btnExp').classList.toggle('active', mode === 'explanation');
    document.getElementById('btnFlash').classList.toggle('active', mode === 'flashcards');
    document.getElementById('btnPrac').classList.toggle('active', mode === 'practice');

    document.getElementById('viewExplanation').style.display = (mode === 'explanation') ? 'flex' : 'none';
    document.getElementById('viewFlashcards').style.display = (mode === 'flashcards') ? 'flex' : 'none';
    document.getElementById('viewPractice').style.display = (mode === 'practice') ? 'flex' : 'none';

    // Ativa padding-bottom no body apenas quando o quiz estiver ativo
    document.body.classList.toggle('quiz-active', mode === 'practice');
    document.getElementById('quizFooter').style.display = (mode === 'practice') ? 'flex' : 'none';

    if (mode === 'flashcards') {
        setTimeout(updateCardHeight, 50);
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ========================================================
   AUTO-FIT INTELIGENTE DE ALTURA DO FLASHCARD
   ======================================================== */
function updateCardHeight() {
    const card = document.getElementById('mainFlashcard');
    const viewport = document.querySelector('.flashcard-viewport');
    const front = document.querySelector('.fc-front');
    const back = document.querySelector('.fc-back');
    if (!card || !viewport || !front || !back) return;

    // Reset temporário para medir a altura natural sem restrições
    card.style.height = 'auto';
    viewport.style.height = 'auto';

    // Mede a altura necessária para frente e verso
    const frontHeight = front.scrollHeight;
    const backHeight = back.scrollHeight;
    
    // Altura mínima segura: 380px no desktop/tablet, 360px no celular pequeno
    const minH = window.innerWidth <= 480 ? 360 : 400;
    const finalHeight = Math.max(frontHeight, backHeight, minH);

    card.style.height = finalHeight + 'px';
    viewport.style.height = finalHeight + 'px';
}

function renderCurrentCard() {
    const cardEl = document.getElementById('mainFlashcard');
    cardEl.classList.remove('is-flipped');

    if (activeCards.length === 0) {
        document.getElementById('fcFrontPrompt').textContent = 'Nenhum flashcard nesta categoria.';
        document.getElementById('fcFrontIllustration').innerHTML = '';
        return;
    }

    const item = activeCards[currentCardIndex];

    // Frente
    document.getElementById('fcFrontTag').textContent = item.tag;
    document.getElementById('fcFrontPrompt').textContent = item.prompt;
    document.getElementById('fcFrontIllustration').innerHTML = item.svg;

    // Verso
    document.getElementById('fcBackTag').textContent = item.tag;
    document.getElementById('fcBackFormulaTitle').textContent = item.formulaTitle;
    document.getElementById('fcBackFormulaContainer').innerHTML = item.verticalHtml;
    document.getElementById('fcBackVars').innerHTML = item.vars;
    document.getElementById('fcBackMacete').innerHTML = item.macete;

    // Contadores
    document.getElementById('fcCounter').textContent = `Card ${currentCardIndex + 1} de ${activeCards.length}`;
    document.getElementById('fcLearnedCount').textContent = learnedCards.size;
    document.getElementById('fcTotalBadge').textContent = activeCards.length;

    // Recalcula a altura exata para que nada corte nem sobre espaço demais
    requestAnimationFrame(updateCardHeight);
}

function flipCurrentCard() {
    const cardEl = document.getElementById('mainFlashcard');
    cardEl.classList.toggle('is-flipped');
}

function nextCard() {
    if (currentCardIndex < activeCards.length - 1) {
        currentCardIndex++;
    } else {
        currentCardIndex = 0;
    }
    renderCurrentCard();
}

function prevCard() {
    if (currentCardIndex > 0) {
        currentCardIndex--;
    } else {
        currentCardIndex = activeCards.length - 1;
    }
    renderCurrentCard();
}

function filterFlashcards(cat, btn) {
    document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    if (cat === 'todos') {
        activeCards = [...FLASHCARDS];
    } else {
        activeCards = FLASHCARDS.filter(c => c.cat === cat);
    }
    currentCardIndex = 0;
    renderCurrentCard();
    renderCardsGrid();
}

function markCardMastery(mastered) {
    const currentItem = activeCards[currentCardIndex];
    if (mastered) {
        learnedCards.add(currentItem.id);
        if (typeof confetti === 'function') {
            confetti({ particleCount: 25, spread: 45, origin: { y: 0.8 } });
        }
    } else {
        learnedCards.delete(currentItem.id);
    }
    document.getElementById('fcLearnedCount').textContent = learnedCards.size;
    setTimeout(() => {
        nextCard();
    }, 200);
}

function toggleGridView() {
    const grid = document.getElementById('fcCardsGrid');
    const isHidden = grid.style.display === 'none' || grid.style.display === '';
    grid.style.display = isHidden ? 'grid' : 'none';
}

function renderCardsGrid() {
    const grid = document.getElementById('fcCardsGrid');
    grid.innerHTML = '';
    activeCards.forEach(c => {
        const item = document.createElement('div');
        item.className = 'fc-grid-item';
        item.innerHTML = `
            <div style="font-size:0.72rem; font-weight:800; color:var(--theme-dark); text-transform:uppercase;">${c.tag}</div>
            <div style="font-weight:700; margin:6px 0; font-size:0.92rem;">${c.prompt}</div>
            <div style="margin:6px 0;">${c.verticalHtml}</div>
            <div style="font-size:0.78rem; color:#475569;">${c.macete}</div>
        `;
        grid.appendChild(item);
    });
}

/* ========================================================
   MOTOR DO QUIZ (PRÁTICA)
   ======================================================== */
function initQuiz() {
    const map = document.getElementById('questionMap');
    map.innerHTML = '';
    QUESTIONS.forEach((q, idx) => {
        const dot = document.createElement('button');
        dot.className = `map-dot ${idx === 0 ? 'active' : ''}`;
        dot.id = `mapDot-${idx}`;
        dot.textContent = idx + 1;
        dot.onclick = () => jumpToQuestion(idx);
        map.appendChild(dot);
    });
    renderQuestion(0);
}

function renderQuestion(index) {
    currentQuestionIndex = index;
    const q = QUESTIONS[index];

    document.querySelectorAll('.map-dot').forEach((d, i) => {
        d.classList.toggle('active', i === index);
    });

    const activeDot = document.getElementById(`mapDot-${index}`);
    if (activeDot) {
        activeDot.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    const badge = document.getElementById('quizDifBadge');
    badge.textContent = q.dif.toUpperCase();
    badge.className = `difficulty-badge dif-${q.dif}`;

    document.getElementById('quizQuestionText').textContent = `${index + 1}. ${q.q}`;

    const cont = document.getElementById('quizOptionsContainer');
    cont.innerHTML = '';
    const letters = ['A', 'B', 'C', 'D'];
    const hasAnswered = userAnswers[index] !== undefined;

    q.options.forEach((opt, optIdx) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        if (hasAnswered) {
            btn.classList.add('disabled');
            if (optIdx === q.correct) btn.classList.add('correct');
            if (userAnswers[index] === optIdx && optIdx !== q.correct) btn.classList.add('wrong');
        } else {
            btn.onclick = () => selectOption(index, optIdx);
        }

        btn.innerHTML = `<span class="opt-circle">${letters[optIdx]}</span> <span>${opt}</span>`;
        cont.appendChild(btn);
    });

    const fbBox = document.getElementById('quizFeedbackBox');
    if (hasAnswered) {
        fbBox.style.display = 'block';
        const isRight = userAnswers[index] === q.correct;
        document.getElementById('quizFeedbackTitle').textContent = isRight ? '✅ RESPOSTA CORRETA!' : '❌ ATENÇÃO!';
        document.getElementById('quizFeedbackTitle').style.color = isRight ? 'var(--correct-border)' : 'var(--wrong-border)';
        document.getElementById('quizFeedbackText').innerHTML = q.explanation;
    } else {
        fbBox.style.display = 'none';
    }

    document.getElementById('quizCounterText').textContent = `${index + 1} / ${QUESTIONS.length}`;
    document.getElementById('btnPrevQ').disabled = (index === 0);
    document.getElementById('btnNextQ').textContent = (index === QUESTIONS.length - 1) ? 'Finalizar' : 'Próxima';
}

function selectOption(qIndex, optIdx) {
    if (userAnswers[qIndex] !== undefined) return;

    userAnswers[qIndex] = optIdx;
    const isCorrect = (optIdx === QUESTIONS[qIndex].correct);

    const dot = document.getElementById(`mapDot-${qIndex}`);
    if (dot) {
        dot.classList.add(isCorrect ? 'answered-correct' : 'answered-wrong');
    }

    renderQuestion(qIndex);

    if (isCorrect && typeof confetti === 'function') {
        confetti({ particleCount: 20, spread: 45, origin: { y: 0.7 } });
    }
}

function navigateQuestion(step) {
    const nextIdx = currentQuestionIndex + step;
    if (nextIdx >= 0 && nextIdx < QUESTIONS.length) {
        renderQuestion(nextIdx);
    } else if (nextIdx >= QUESTIONS.length) {
        checkQuizCompletion();
    }
}

function jumpToQuestion(idx) {
    renderQuestion(idx);
}

function checkQuizCompletion() {
    const answeredCount = Object.keys(userAnswers).length;
    if (answeredCount < QUESTIONS.length) {
        alert(`Você respondeu ${answeredCount} de ${QUESTIONS.length} questões. Continue praticando para ver seu resultado final!`);
        return;
    }

    let score = 0;
    QUESTIONS.forEach((q, idx) => {
        if (userAnswers[idx] === q.correct) score++;
    });

    const percent = Math.round((score / QUESTIONS.length) * 100);

    document.getElementById('quizCard').style.display = 'none';
    document.getElementById('questionMap').style.display = 'none';
    document.getElementById('quizFooter').style.display = 'none';

    const resCard = document.getElementById('resultCard');
    resCard.style.display = 'block';

    document.getElementById('percentDisplay').textContent = `${percent}%`;
    document.getElementById('scoreSummary').textContent = `Você acertou ${score} de ${QUESTIONS.length} questões!`;

    let stars = '⭐⭐⭐';
    if (percent === 100) stars = '⭐⭐⭐⭐⭐';
    else if (percent >= 80) stars = '⭐⭐⭐⭐';
    else if (percent >= 60) stars = '⭐⭐⭐';
    else if (percent >= 40) stars = '⭐⭐';
    else stars = '⭐';
    document.getElementById('starsDisplay').textContent = stars;

    if (typeof confetti === 'function') {
        confetti({ particleCount: 90, spread: 65, origin: { y: 0.6 } });
    }
    resCard.scrollIntoView({ behavior: 'smooth' });
}

function restartQuiz() {
    userAnswers = {};
    document.getElementById('quizCard').style.display = 'block';
    document.getElementById('questionMap').style.display = 'flex';
    document.getElementById('quizFooter').style.display = 'flex';
    document.getElementById('resultCard').style.display = 'none';
    initQuiz();
}

/* ========================================================
   BUSCA NA ABA DE TEORIA
   ======================================================== */
document.getElementById('searchInput').addEventListener('input', function(e) {
    const term = e.target.value.toLowerCase().trim();
    const blocks = document.querySelectorAll('.theory-searchable');
    let visibleCount = 0;

    blocks.forEach(block => {
        const text = block.textContent.toLowerCase();
        if (text.includes(term)) {
            block.style.display = 'flex';
            visibleCount++;
        } else {
            block.style.display = 'none';
        }
    });

    document.getElementById('no-results').style.display = (visibleCount === 0) ? 'block' : 'none';
});

/* ========================================================
   INICIALIZAÇÃO & RESIZE LISTENER
   ======================================================== */
window.addEventListener('DOMContentLoaded', () => {
    document.getElementById('totalCardsCount').textContent = FLASHCARDS.length;
    renderCurrentCard();
    renderCardsGrid();
    initQuiz();
});

// Atualiza a altura do card quando a tela girar ou for redimensionada
window.addEventListener('resize', () => {
    if (activeMode === 'flashcards') {
        updateCardHeight();
    }
});
</script>
