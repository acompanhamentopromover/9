                    <circle class="d-fundo" cx="55" cy="55" r="42"/>
                    <rect class="d-linha" x="25" y="25" width="60" height="60"/>
                    <line class="d-tracejado" x1="55" y1="55" x2="55" y2="85"/>
                    <text class="d-texto" x="55" y="112" text-anchor="middle">Quadrado</text>

                    <!-- Triângulo Equilátero -->
                    <circle class="d-fundo" cx="170" cy="55" r="42"/>
                    <polygon class="d-linha" points="170,15 133,78 207,78"/>
                    <line class="d-tracejado" x1="170" y1="55" x2="170" y2="78"/>
                    <text class="d-texto" x="170" y="112" text-anchor="middle">Triângulo Equil.</text>

                    <!-- Hexágono Regular -->
                    <circle class="d-fundo" cx="285" cy="55" r="42"/>
                    <polygon class="d-linha" points="285,13 321,34 321,76 285,97 249,76 249,34"/>
                    <line class="d-tracejado" x1="285" y1="55" x2="303" y2="55"/>
                    <text class="d-texto" x="285" y="112" text-anchor="middle">Hexágono</text>
                </svg>

                <div class="table-responsive">
                    <table class="tabela">
                        <thead>
                            <tr>
                                <th>Polígono</th>
                                <th>Lado (l)</th>
                                <th>Apótema (a)</th>
                                <th>Relação Prática</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Quadrado</strong></td>
                                <td><strong>l₄ = R · √2</strong></td>
                                <td>
                                    <div class="vfrac">
                                        <span class="vnum">R · √2</span>
                                        <span class="vden">2</span>
                                    </div>
                                </td>
                                <td>a₄ = <span class="vfrac"><span class="vnum">l₄</span><span class="vden">2</span></span> (metade do lado)</td>
                            </tr>
                            <tr>
                                <td><strong>Triângulo Equil.</strong></td>
                                <td><strong>l₃ = R · √3</strong></td>
                                <td>
                                    <div class="vfrac">
                                        <span class="vnum">R</span>
                                        <span class="vden">2</span>
                                    </div>
                                </td>
                                <td>Metade exata do raio!</td>
                            </tr>
                            <tr>
                                <td><strong>Hexágono Reg.</strong></td>
                                <td><strong>l₆ = R</strong></td>
                                <td>
                                    <div class="vfrac">
                                        <span class="vnum">R · √3</span>
                                        <span class="vden">2</span>
                                    </div>
                                </td>
                                <td>Lado = Raio; apótema é a altura</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Bloco 2: Relações Métricas -->
        <div class="content-group theory-searchable">
